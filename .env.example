# Database
DATABASE_URL=sqlite+aiosqlite:///./data/jobscout.db

# LLM Configuration
LLM_PROVIDER=openai  # openai or ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=gpt-4o-mini

# CAPTCHA Solver
CAPTCHA_PROVIDER=  # 2captcha or capsolver (leave blank to disable)
CAPTCHA_API_KEY=

# Proxies (comma-separated, e.g. http://user:pass@host:port)
PROXY_LIST=

# Notifications (comma-separated Apprise URLs)
# Telegram: tgram://bot_token/chat_id
# Discord: discord://webhook_id/webhook_token
APPRISE_URLS=

# Matching
MATCH_THRESHOLD=70

# Scraping Schedule
SCRAPE_INTERVAL_HOURS=6

# Anti-Bot
UA_ROTATION_ENABLED=true
