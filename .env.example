# Database
DATABASE_URL=sqlite+aiosqlite:///./data/jobscout.db

# Auth
SECRET_KEY=change-me-run-openssl-rand-hex-32

# LLM Configuration
LLM_PROVIDER=gemini  # openai, gemini, or ollama
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=gemini-2.5-flash

# CAPTCHA Solver (FlareSolverr runs as a Docker sidecar — no API key needed)
CAPTCHA_PROVIDER=flaresolverr
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Proxies (comma-separated, e.g. http://user:pass@host:port)
PROXY_LIST=

# Notifications (comma-separated Apprise URLs)
# Telegram: tgram://bot_token/chat_id
# Discord: discord://webhook_id/webhook_token
APPRISE_URLS=

# Matching
MATCH_THRESHOLD=70

# Scraping Schedule
SCRAPE_INTERVAL_HOURS=6

# Anti-Bot
UA_ROTATION_ENABLED=true

# Preferences
PREFERRED_COUNTRIES=
